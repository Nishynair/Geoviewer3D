{
  "name": "@nish-andran/spatial-doctor",
  "version": "1.0.0",
  "description": "Deterministic GeoJSON inspection and geometry measurements.",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nishynair/Geoviewer3D.git",
    "directory": "packages/spatial-doctor"
  },
  "homepage": "https://github.com/Nishynair/Geoviewer3D/tree/main/packages/spatial-doctor#readme",
  "bugs": {
    "url": "https://github.com/Nishynair/Geoviewer3D/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@placemarkio/check-geojson": "^0.1.14"
  }
}
